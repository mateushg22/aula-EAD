# 1. Cria o projeto em branco (JavaScript)
npx create-expo-app@latest app-gatos --template blank

# 2. Entra na pasta do projeto
cd app-gatos

# 3. Instala o Axios
npm install axios



  app-gatos/
├── App.js
├── package.json
└── src/
    ├── services/
    │   └── api.js        # Configuração do Axios
    └── screens/
        └── Home.js       # Tela principal do aplicativo


 Configurar o Axios (src/services/api.js)
Crie o arquivo api.js dentro de src/services/ para centralizar a URL base da API:

JavaScript
import axios from 'axios';

const api = axios.create({
  baseURL: 'https://api.thecatapi.com/v1',
});

export default api;


Criar a tela e consumir a API (src/screens/Home.js)
A API [https://api.thecatapi.com/v1/images/search](https://api.thecatapi.com/v1/images/search) retorna um array contendo um objeto com a propriedade url (ex: [{ "url": "https://..." }]). Por isso, acessamos response.data[0].url.

Crie o arquivo Home.js dentro de src/screens/:

JavaScript
import React, { useState } from 'react';
import {
  StyleSheet,
  Text,
  View,
  Image,
  TouchableOpacity,
  ActivityIndicator,
  Alert,
} from 'react-native';
import api from '../services/api';

export default function Home() {
  const [catImage, setCatImage] = useState(null);
  const [loading, setLoading] = useState(false);

  async function buscarGatinho() {
    try {
      setLoading(true);
      const response = await api.get('/images/search');
      
      // A API retorna uma lista (array), pegamos o primeiro item [0]
      setCatImage(response.data[0].url);
    } catch (error) {
      Alert.alert('Erro', 'Não foi possível carregar a imagem do gatinho.');
      console.error(error);
    } finally {
      setLoading(false);
    }
  }

  return (
    <View style={styles.container}>
      <Text style={styles.title}>🐱 Gatos Aleatórios</Text>

      <View style={styles.imageContainer}>
        {loading ? (
          <ActivityIndicator size="large" color="#FF6B6B" />
        ) : catImage ? (
          <Image source={{ uri: catImage }} style={styles.image} />
        ) : (
          <Text style={styles.placeholderText}>
            Clique no botão abaixo para ver um gatinho!
          </Text>
        )}
      </View>

      <TouchableOpacity
        style={styles.button}
        onPress={buscarGatinho}
        disabled={loading}
      >
        <Text style={styles.buttonText}>
          {loading ? 'Buscando...' : 'Ver Gatinho'}
        </Text>
      </TouchableOpacity>
    </View>
  );
}

const styles = StyleSheet.create({
