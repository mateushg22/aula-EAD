import React from 'react';
import { TouchableOpacity, Text, StyleSheet, Alert } from 'react-native';

export default function Botao({ texto, corFundo, corTexto, mensagem }) {
  return (
    <TouchableOpacity
      style={[styles.botao, { backgroundColor: corFundo }]}
      onPress={() => Alert.alert('Aviso', mensagem)}
    >
      <Text style={[styles.texto, { color: corTexto }]}>{texto}</Text>
    </TouchableOpacity>
  );
}

const styles = StyleSheet.create({
  botao: {
    flex: 1,
    padding: 15,
    borderRadius: 8,
    alignItems: 'center',
  },
  texto: {
    fontSize: 16,
    fontWeight: 'bold',
  },
});


